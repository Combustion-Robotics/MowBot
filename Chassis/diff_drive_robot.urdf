<?xml version="1.0"?>
<robot name="hoverboard_diff_drive">

  <!-- ======================== BASE LINK ======================== -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.7 0.46 0.1"/>
      </geometry>
      <origin xyz="0.3 0 0" rpy="0 0 0"/>
      <material name="gray">
        <color rgba="0.4 0.4 0.4 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.7 0.46 0.1"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="15.0"/>
      <!-- Inertia for a box: I = m/12 * (b^2 + c^2) -->
      <inertia ixx="0.233" ixy="0.0" ixz="0.0"
               iyy="0.475" iyz="0.0"
               izz="0.667"/>
    </inertial>
  </link>

  <!-- ======================== LEFT WHEEL ======================== -->
  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.09" length="0.06"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.09" length="0.06"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <mass value="2.5"/>
      <!-- Solid cylinder: Ixx = Iyy = m/12*(3r^2+h^2), Izz = m/2*r^2 -->
      <inertia ixx="0.0393" ixy="0.0" ixz="0.0"
               iyy="0.0393" iyz="0.0"
               izz="0.0361"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <!-- Left side: +y offset; wheel centre is at base height minus drop to ground -->
    <origin xyz="0.0 0.26 -0.01" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ======================== RIGHT WHEEL ======================== -->
  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.09" length="0.06"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.09" length="0.06"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <mass value="2.5"/>
      <inertia ixx="0.0393" ixy="0.0" ixz="0.0"
               iyy="0.0393" iyz="0.0"
               izz="0.0361"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <!-- Right side: -y offset -->
    <origin xyz="0.0 -0.26 -0.01" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ======================== CASTER (front) ======================== -->
  <!-- Passive support so the chassis doesn't tip. -->
  <link name="caster_front">
    <visual>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.00019" ixy="0.0" ixz="0.0"
               iyy="0.00019" iyz="0.0"
               izz="0.00019"/>
    </inertial>
  </link>

  <joint name="caster_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_front"/>
    <origin xyz="0.63 0.0 -0.07" rpy="0 0 0"/>
  </joint>



</robot>
